{
  "name": "OneClickToShop",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "postinstall": "patch-package",
    "fastpatch": "patch-package react-native-fast-image",
    "apk": "cd android && ./gradlew assembleRelease && cd ..",
    "aab": "cd android && ./gradlew bundleRelease && cd ..",
    "podinstall": "cd ios && RCT_NEW_ARCH_ENABLED=0 RUBYOPT=-rlogger pod install && cd ..",
    "xcodebuild": "RCT_NEW_ARCH_ENABLED=0 xcodebuild -workspace ios/OneClickToShop.xcworkspace -scheme OneClickToShop -configuration Release -destination 'generic/platform=iOS' -archivePath \"$HOME/Library/Developer/Xcode/Archives/$(date +%Y-%m-%d)/OneClickToShop-$(date +%Y-%m-%d-%H%M%S).xcarchive\" archive",
    "debugger": "react-native start --debugger-host 127.0.0.1:8081"
  },
  "dependencies": {
    "@native-html/iframe-plugin": "^2.6.1",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-clipboard/clipboard": "^1.14.1",
    "@react-native-community/checkbox": "^0.5.17",
    "@react-native-firebase/app": "24.0.0",
    "@react-native-firebase/messaging": "24.0.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/elements": "^1.3.31",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@react-navigation/stack": "^6.4.1",
    "axios": "^1.7.4",
    "i18n-js": "^4.4.3",
    "moment": "^2.30.1",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "react": "18.3.1",
    "react-i18next": "^15.0.1",
    "react-native": "0.77.3",
    "react-native-device-info": "^11.1.0",
    "react-native-document-picker": "^9.3.0",
    "react-native-dropdown-select-list": "^2.0.5",
    "react-native-fast-image": "8.6.3",
    "react-native-gesture-handler": "2.31.0",
    "react-native-image-modal": "^3.0.10",
    "react-native-image-slider-banner": "^1.0.3",
    "react-native-ionicons": "^4.6.5",
    "react-native-localize": "^3.2.1",
    "react-native-picker-select": "9.3.1",
    "react-native-receive-sharing-intent": "^2.0.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.14.1",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.2.0",
    "react-native-webview": "^14.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/cli": "15.1.3",
    "@react-native/babel-preset": "0.77.3",
    "@react-native/eslint-config": "0.77.3",
    "@react-native/metro-config": "0.77.3",
    "@react-native/typescript-config": "0.77.3",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.19.0",
    "javascript-obfuscator": "^4.1.1",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-svg-transformer": "^1.5.0",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@3.6.4"
}
